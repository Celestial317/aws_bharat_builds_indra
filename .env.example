# Copy to .env and fill in. Everything is optional: with no keys the app still runs
# (deterministic engines + offline knowledge-base answers); keys only switch on LLM enrichment.

# --- LLM: any OpenAI-compatible endpoint. OpenRouter (default), or a local model (free, no key):
#   LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.1        (Ollama)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1500

# --- Knowledge base (RAG). Empty OPENSEARCH_URL = local on-disk index (data/index).
OPENSEARCH_URL=
OPENSEARCH_INDEX=indra-knowledge

# --- Auth. demo = trust X-Demo-User header (local dev only). firebase = verify ID tokens.
INDRA_ENV=development
AUTH_MODE=demo
FIREBASE_PROJECT_ID=indra-164b4
ADMIN_UIDS=

# --- Services
TELEMETRY_URL=http://127.0.0.1:8090
TELEMETRY_SERVICE_KEY=dev-service-key

# --- AWS-compatible alert store. LocalStack: http://localhost:4566 ; empty = in-memory
AWS_ENDPOINT_URL=
AWS_REGION=ap-south-1

# --- Server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
